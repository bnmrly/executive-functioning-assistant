{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dashboard development server",
      "type": "process",
      "command": "npm",
      "args": ["--prefix", "dashboard", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Mirror Android tablet",
      "type": "process",
      "command": "/opt/homebrew/bin/scrcpy",
      "args": ["--select-tcpip", "--no-control", "--no-audio", "--window-title", "Android tablet — live screen", "--max-size", "1280", "--max-fps", "30"],
      "options": {
        "env": { "ADB": "${env:HOME}/Library/Android/sdk/platform-tools/adb" }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
